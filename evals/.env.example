# Copy to .env and fill in. Never commit .env.
# GitHub token used ONLY for reading other repos via the REST API (dataset building).
EVALS_GITHUB_TOKEN=
# LLM providers (free tiers). At least one is needed for real (non-mock) runs.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional overrides
# EVALS_REVIEWER_PROVIDER=gemini        # gemini | groq | mock
# EVALS_REVIEWER_MODEL=gemini-3.1-flash-lite
# EVALS_JUDGE_PROVIDER=groq             # gemini | groq | mock
# EVALS_JUDGE_MODEL=openai/gpt-oss-120b
# EVALS_REPOS_DIR=.cache/repos          # where dataset builder clones repos
